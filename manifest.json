{
    "manifest_version":  3,
    "name":  "FocusLock",
    "version":  "0.3.0",
    "description":  "Strict browser focus mode with reusable website sets and timed browsing control.",
    "browser_specific_settings":  {
                                      "gecko":  {
                                                    "id":  "focuslock-v2@local",
                                                    "data_collection_permissions":  {
                                                                                        "required":  [
                                                                                                         "none"
                                                                                                     ]
                                                                                    }
                                                }
                                  },
    "permissions":  [
                        "storage",
                        "tabs",
                        "alarms",
                        "search",
                        "declarativeNetRequest"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "icons":  {
                  "48":  "icons/focuslock.svg",
                  "96":  "icons/focuslock.svg"
              },
    "background":  {
                       "scripts":  [
                                       "focuslock-engine.js",
                                       "focuslock-background.js"
                                   ]
                   },
    "action":  {
                   "default_title":  "FocusLock",
                   "default_popup":  "focuslock-popup/focuslock-popup.html",
                   "default_area":  "navbar",
                   "default_icon":  {
                                        "16":  "icons/focuslock.svg",
                                        "32":  "icons/focuslock.svg",
                                        "48":  "icons/focuslock.svg"
                                    }
               },
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "focuslock-blocked.html"
                                                       ],
                                         "matches":  [
                                                         "*://*/*"
                                                     ]
                                     }
                                 ],
    "declarative_net_request":  {
                                    "rule_resources":  [
                                                           {
                                                               "id":  "base",
                                                               "enabled":  true,
                                                               "path":  "rules-empty.json"
                                                           }
                                                       ]
                                }
}
